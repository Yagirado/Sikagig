        <mxCell id="constraints_users" value="&lt;b&gt;users | Constraints dan indeks&lt;/b&gt;&lt;br&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;UNIQUE KEY users_email_unique (email)&lt;br&gt;&lt;br&gt;UNIQUE KEY users_nim_unique (NIM)&lt;br&gt;&lt;br&gt;CONSTRAINT users_email_not_blank CHECK (CHAR_LENGTH(TRIM(email)) &amp;gt; 0)&lt;br&gt;&lt;br&gt;CONSTRAINT users_nim_valid CHECK ( NIM IS NULL OR (CHAR_LENGTH(NIM) = 13 AND NIM NOT REGEXP &amp;#x27;[^0-9]&amp;#x27;) )&lt;br&gt;&lt;br&gt;CONSTRAINT users_gender_valid CHECK ( gender IS NULL OR gender IN (&amp;#x27;man&amp;#x27;, &amp;#x27;woman&amp;#x27;) )&lt;br&gt;&lt;br&gt;CONSTRAINT users_legal_agreement_valid CHECK ( legal_agreement IN (0, 1) )&lt;br&gt;&lt;br&gt;CONSTRAINT users_privacy_agreement_valid CHECK ( privacy_agreement IN (0, 1) )&lt;br&gt;&lt;br&gt;CONSTRAINT users_complete_profile_required_fields CHECK ( profile_completed_at IS NULL OR ( NIM IS NOT NULL AND fullName IS NOT NULL AND CHAR_LENGTH(TRIM(fullName)) &amp;gt; 0 AND phone IS NOT NULL AND CHAR_LENGTH(TRIM(phone)) &amp;gt; 0 AND gender IS NOT NULL AND tanggal_lahir IS NOT NULL AND legal_agreement = 1 AND privacy_agreement = 1 ) )" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=16;fontFamily=Courier New;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1400" width="900" height="800" as="geometry" />
        </mxCell>
        <mxCell id="constraints_google_accounts" value="&lt;b&gt;google_accounts | Constraints dan indeks&lt;/b&gt;&lt;br&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;UNIQUE KEY google_accounts_sub_unique (google_sub)&lt;br&gt;&lt;br&gt;UNIQUE KEY google_accounts_user_unique (user_id)&lt;br&gt;&lt;br&gt;CONSTRAINT google_accounts_sub_not_blank CHECK (CHAR_LENGTH(TRIM(google_sub)) &amp;gt; 0)&lt;br&gt;&lt;br&gt;CONSTRAINT google_accounts_user_fk FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=16;fontFamily=Courier New;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1400" width="900" height="800" as="geometry" />
        </mxCell>
        <mxCell id="constraints_email_otps" value="&lt;b&gt;email_otps | Constraints dan indeks&lt;/b&gt;&lt;br&gt;&lt;br&gt;PRIMARY KEY (id)&lt;br&gt;&lt;br&gt;UNIQUE KEY email_otps_user_purpose_unique (user_id, purpose)&lt;br&gt;&lt;br&gt;KEY email_otps_expires_at_index (expires_at)&lt;br&gt;&lt;br&gt;CONSTRAINT email_otps_purpose_valid CHECK (purpose IN (&amp;#x27;login&amp;#x27;, &amp;#x27;register&amp;#x27;))&lt;br&gt;&lt;br&gt;CONSTRAINT email_otps_attempts_valid CHECK ( max_attempts BETWEEN 1 AND 10 AND attempts &amp;lt;= max_attempts )&lt;br&gt;&lt;br&gt;CONSTRAINT email_otps_expiry_valid CHECK (expires_at &amp;gt; sent_at)&lt;br&gt;&lt;br&gt;CONSTRAINT email_otps_user_fk FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE" style="rounded=0;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=16;fontFamily=Courier New;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
