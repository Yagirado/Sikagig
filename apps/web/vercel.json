{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.sikagig.me/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://api.sikagig.me/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
