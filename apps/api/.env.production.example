APP_NAME=SIKAGIG
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sikagig.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikagig
DB_USERNAME=sikagig
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FRONTEND_URL="${APP_URL}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/origin used by browsers; serve WSS through HTTPS on this same domain.
REVERB_HOST=sikagig.example
REVERB_PORT=443
REVERB_SCHEME=https
# Hostnames only, comma-separated. Keep this restricted to the deployed app origin.
REVERB_ALLOWED_ORIGINS=sikagig.example
# Internal Reverb listener; expose it through the HTTPS reverse proxy, not directly.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional: set these only if admin Telegram alerts are enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Database user ID for the dedicated admin account that receives platform commission.
PLATFORM_WALLET_USER_ID=
